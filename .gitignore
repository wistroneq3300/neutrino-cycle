# Campaigns stay ignored by default (AGENTS.md: generated evidence is never
# committed). Real evidence is published on purpose to this branch only, with
# SSH state and writer locks excluded:
#   git add -f campaigns && git reset -- campaigns/**/.ssh campaigns/**/.report-writer.lock
#   git commit -m "evidence: <run ids>"
campaigns/
campaigns/**/.ssh/
campaigns/**/.report-writer.lock
